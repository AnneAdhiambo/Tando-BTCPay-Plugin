<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="coverlet.collector" Version="6.0.4" />
		<PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
		<PackageReference Include="xunit.v3" Version="3.2.2" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

	<ItemDefinitionGroup>
		<ProjectReference>
			<Properties>StaticWebAssetsEnabled=false</Properties>
		</ProjectReference>
	</ItemDefinitionGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\btcpayserver\BTCPayServer\BTCPayServer.csproj">
			<PrivateAssets>all</PrivateAssets>
		</ProjectReference>
		<ProjectReference Include="..\..\btcpayserver\BTCPayServer.Tests\BTCPayServer.Tests.csproj">
			<PrivateAssets>all</PrivateAssets>
		</ProjectReference>
		<ProjectReference Include="..\BTCPayServer.Plugins.Tando\BTCPayServer.Plugins.Tando.csproj" />
	</ItemGroup>

	<Target Name="WriteTandoDebugPlugins" AfterTargets="Build">
		<PropertyGroup>
			<TandoPluginDll>$([System.IO.Path]::GetFullPath('$(OutDir)BTCPayServer.Plugins.Tando.dll').Replace('\', '/'))</TandoPluginDll>
		</PropertyGroup>
		<WriteLinesToFile File="$(OutDir)appsettings.dev.json"
		                  Lines="{&quot;DEBUG_PLUGINS&quot;:&quot;$(TandoPluginDll)&quot;}"
		                  Overwrite="true" />
	</Target>
	
</Project>
